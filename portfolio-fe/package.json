{
  "name": "@teethana/web",
  "version": "0.1.0",
  "private": true,
  "description": "A blue 3D portfolio with a curated bookshelf, GitHub sync, and an owner-only workspace.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@designcodeio/threeui": "1.2.0",
    "hono": "4.13.14",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "three165": "npm:three@0.165.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
