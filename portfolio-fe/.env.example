# The deployed origin, with no trailing slash. Local development uses localhost.
APP_URL=http://localhost:3000
# Local Compose database. For Neon, use its pooled URL with sslmode=verify-full.
DATABASE_URL=postgresql://portfolio:change-me-local-only@127.0.0.1:5547/portfolio
# Optional direct connection for migrations, import, and backup commands.
DATABASE_URL_UNPOOLED=
# Used only by local Docker Compose; match the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me-local-only
# Tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql://portfolio:change-me-local-only@127.0.0.1:5547/portfolio_test
GITHUB_OWNER=TeeThana
OWNER_GITHUB_ID=155901166

# Create a GitHub OAuth App. Callback: APP_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate at least 32 random bytes. Keep this stable between restarts.
AUTH_SECRET=
# Optional server-only token to increase GitHub API limits for public repositories.
GITHUB_TOKEN=
